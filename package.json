{
  "name": "rostrum",
  "displayName": "Rostrum ACP",
  "description": "Run several coding agents at once in VS Code. Background sessions survive window reloads, nothing runs until you approve it, and every edit, tool call, and reasoning step stays inspectable. Works with any Agent Client Protocol agent.",
  "version": "0.19.0",
  "preview": true,
  "publisher": "ryanpavlick",
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#071b5a",
    "theme": "dark"
  },
  "type": "module",
  "main": "./out/extension.cjs",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rostrum-explorer",
          "title": "Rostrum",
          "icon": "resources/sidebar.svg"
        }
      ]
    },
    "views": {
      "rostrum-explorer": [
        {
          "id": "rostrum.sessionsView",
          "name": "Sessions",
          "icon": "$(list-unordered)",
          "initialSize": 300
        },
        {
          "id": "rostrum.outlineView",
          "name": "Outline",
          "icon": "$(list-tree)",
          "initialSize": 300
        },
        {
          "id": "rostrum.changedFilesView",
          "name": "Changes",
          "icon": "$(edit-code)",
          "initialSize": 300
        },
        {
          "id": "rostrum.timelineView",
          "name": "Timeline",
          "icon": "$(diff)",
          "initialSize": 300
        },
        {
          "id": "rostrum.usageStatsView",
          "name": "Usage Stats",
          "icon": "$(dashboard)",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "rostrum.chatView",
          "name": "Rostrum Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "commands": [
      {
        "command": "rostrum.newSession",
        "title": "Rostrum: New Session",
        "icon": "$(add)"
      },
      {
        "command": "rostrum.cancel",
        "title": "Rostrum: Cancel Turn",
        "icon": "$(stop-circle)"
      },
      {
        "command": "rostrum.pickAgent",
        "title": "Rostrum: Select Agent"
      },
      {
        "command": "rostrum.editSettings",
        "title": "Rostrum: Edit Agent Settings"
      },
      {
        "command": "rostrum.openDiff",
        "title": "Rostrum: Open Diff"
      },
      {
        "command": "rostrum.restartAgent",
        "title": "Rostrum: Restart Agent"
      },
      {
        "command": "rostrum.installAgent",
        "title": "Rostrum: Install Agent from Registry",
        "icon": "$(cloud-download)"
      },
      {
        "command": "rostrum.loadSession",
        "title": "Rostrum: Load Session"
      },
      {
        "command": "rostrum.pickSession",
        "title": "Rostrum: Open Session",
        "icon": "$(history)"
      },
      {
        "command": "rostrum.searchSessions",
        "title": "Rostrum: Search Session Transcripts",
        "icon": "$(search)"
      },
      {
        "command": "rostrum.retryRecovery",
        "title": "Rostrum: Retry Session Recovery",
        "icon": "$(debug-restart)"
      },
      {
        "command": "rostrum.agentDiagnostics",
        "title": "Rostrum: Show Agent Diagnostics",
        "icon": "$(pulse)"
      },
      {
        "command": "rostrum.deleteSession",
        "title": "Rostrum: Delete Session",
        "icon": "$(trash)"
      },
      {
        "command": "rostrum.refreshSessions",
        "title": "Rostrum: Refresh Agent Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "rostrum.exportSession",
        "title": "Rostrum: Export Session Transcript",
        "icon": "$(export)"
      },
      {
        "command": "rostrum.clearUsage",
        "title": "Rostrum: Clear Usage Stats",
        "icon": "$(clear-all)"
      },
      {
        "command": "rostrum.clearHistory",
        "title": "Rostrum: Clear Change History",
        "icon": "$(clear-all)"
      },
      {
        "command": "rostrum.revealTurn",
        "title": "Rostrum: Reveal Turn in Chat"
      },
      {
        "command": "rostrum.openHistoryDiff",
        "title": "Rostrum: Open Historical Agent Diff"
      },
      {
        "command": "rostrum.supervisorStatus",
        "title": "Rostrum: Show Background Agent Status",
        "icon": "$(server-process)"
      },
      {
        "command": "rostrum.stopSupervisor",
        "title": "Rostrum: Stop Background Agents"
      },
      {
        "command": "rostrum.clearLocalData",
        "title": "Rostrum: Clear Local Data",
        "icon": "$(trash)"
      },
      {
        "command": "rostrum.showAgentLog",
        "title": "Rostrum: Show Agent Log"
      },
      {
        "command": "rostrum.revealSession",
        "title": "Rostrum: Show Conversation"
      },
      {
        "command": "rostrum.detectAgents",
        "title": "Rostrum: Detect Installed Agents",
        "icon": "$(search)"
      },
      {
        "command": "rostrum.attachActiveFile",
        "title": "Rostrum: Attach Active File",
        "icon": "$(file-add)"
      },
      {
        "command": "rostrum.attachSelection",
        "title": "Rostrum: Attach Selection",
        "icon": "$(selection)"
      },
      {
        "command": "rostrum.attachDiagnostics",
        "title": "Rostrum: Attach Diagnostics",
        "icon": "$(warning)"
      },
      {
        "command": "rostrum.attachOpenEditors",
        "title": "Rostrum: Attach Open Editors",
        "icon": "$(layout)"
      },
      {
        "command": "rostrum.attachWorkspaceLayout",
        "title": "Rostrum: Attach Workspace Layout",
        "icon": "$(folder-library)"
      },
      {
        "command": "rostrum.changesAsTree",
        "title": "Rostrum: Show Changes as Tree",
        "icon": "$(list-tree)"
      },
      {
        "command": "rostrum.changesAsList",
        "title": "Rostrum: Show Changes as List",
        "icon": "$(list-flat)"
      },
      {
        "command": "rostrum.filterTimeline",
        "title": "Rostrum: Filter Timeline",
        "icon": "$(filter)"
      },
      {
        "command": "rostrum.clearTimelineFilter",
        "title": "Rostrum: Clear Timeline Filter",
        "icon": "$(filter-filled)"
      },
      {
        "command": "rostrum.compareWithCurrent",
        "title": "Rostrum: Compare Agent Edit with Current File",
        "icon": "$(git-compare)"
      },
      {
        "command": "rostrum.filterSessions",
        "title": "Rostrum: Filter Sessions",
        "icon": "$(filter)"
      },
      {
        "command": "rostrum.clearSessionFilter",
        "title": "Rostrum: Clear Session Filter",
        "icon": "$(filter-filled)"
      },
      {
        "command": "rostrum.setPermissionMode",
        "title": "Rostrum: Set Agent Permission Mode",
        "icon": "$(shield)"
      },
      {
        "command": "rostrum.openFileDiff",
        "title": "Rostrum: Show All Agent Changes to a File",
        "icon": "$(diff)"
      },
      {
        "command": "rostrum.nextEdit",
        "title": "Rostrum: Next Agent Edit",
        "icon": "$(arrow-right)"
      },
      {
        "command": "rostrum.previousEdit",
        "title": "Rostrum: Previous Agent Edit",
        "icon": "$(arrow-left)"
      },
      {
        "command": "rostrum.openLastEditForFile",
        "title": "Rostrum: Open Last Agent Edit for This File",
        "icon": "$(diff-single)"
      },
      {
        "command": "rostrum.copySessionId",
        "title": "Rostrum: Copy Session ID"
      },
      {
        "command": "rostrum.newSessionInDirectory",
        "title": "Rostrum: New Session in Directory…"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rostrum.newSession",
          "when": "view == rostrum.chatView",
          "group": "navigation@1"
        },
        {
          "command": "rostrum.cancel",
          "when": "view == rostrum.chatView",
          "group": "navigation@2"
        },
        {
          "command": "rostrum.installAgent",
          "when": "view == rostrum.sessionsView",
          "group": "navigation@1"
        },
        {
          "command": "rostrum.refreshSessions",
          "when": "view == rostrum.sessionsView",
          "group": "navigation@2"
        },
        {
          "command": "rostrum.clearHistory",
          "when": "view == rostrum.changedFilesView",
          "group": "navigation@1"
        },
        {
          "command": "rostrum.clearHistory",
          "when": "view == rostrum.timelineView",
          "group": "navigation@1"
        },
        {
          "command": "rostrum.clearUsage",
          "when": "view == rostrum.usageStatsView",
          "group": "navigation@1"
        },
        {
          "command": "rostrum.detectAgents",
          "when": "view == rostrum.sessionsView",
          "group": "navigation@0"
        },
        {
          "command": "rostrum.changesAsTree",
          "when": "view == rostrum.changedFilesView && !rostrum.changesGrouped",
          "group": "navigation@0"
        },
        {
          "command": "rostrum.changesAsList",
          "when": "view == rostrum.changedFilesView && rostrum.changesGrouped",
          "group": "navigation@0"
        },
        {
          "command": "rostrum.filterTimeline",
          "when": "view == rostrum.timelineView && !rostrum.timelineFiltered",
          "group": "navigation@0"
        },
        {
          "command": "rostrum.clearTimelineFilter",
          "when": "view == rostrum.timelineView && rostrum.timelineFiltered",
          "group": "navigation@0"
        },
        {
          "command": "rostrum.filterSessions",
          "when": "view == rostrum.sessionsView && !rostrum.sessionsFiltered",
          "group": "navigation@3"
        },
        {
          "command": "rostrum.clearSessionFilter",
          "when": "view == rostrum.sessionsView && rostrum.sessionsFiltered",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "rostrum.exportSession",
          "when": "viewItem == rostrum.session",
          "group": "inline@1"
        },
        {
          "command": "rostrum.deleteSession",
          "when": "viewItem == rostrum.session",
          "group": "inline@2"
        },
        {
          "command": "rostrum.openFileDiff",
          "when": "viewItem == rostrum.changedFile",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "rostrum.loadSession",
          "when": "false"
        },
        {
          "command": "rostrum.revealTurn",
          "when": "false"
        },
        {
          "command": "rostrum.revealSession",
          "when": "false"
        },
        {
          "command": "rostrum.compareWithCurrent",
          "when": "false"
        },
        {
          "command": "rostrum.openHistoryDiff",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "rostrum.attachSelection",
          "when": "editorHasSelection",
          "group": "navigation@50"
        },
        {
          "command": "rostrum.attachActiveFile",
          "group": "navigation@51"
        },
        {
          "command": "rostrum.attachDiagnostics",
          "group": "navigation@52"
        }
      ]
    },
    "configuration": {
      "title": "Rostrum",
      "properties": {
        "rostrum.agents": {
          "type": "object",
          "default": {},
          "markdownDescription": "Agent definitions, keyed by display name. Each value is `{ command, args, env, cwd, mcpServers? }`. Agent `mcpServers` override same-named global servers."
        },
        "rostrum.defaultAgent": {
          "type": "string",
          "default": "",
          "description": "Agent selected on startup."
        },
        "rostrum.permissionMode": {
          "type": "string",
          "enum": [
            "ask",
            "acceptEdits",
            "yolo"
          ],
          "default": "ask",
          "description": "How to answer agent permission requests."
        },
        "rostrum.mcpServers": {
          "type": "object",
          "default": {},
          "markdownDescription": "MCP servers passed to every session, keyed by name. Stdio values are `{ command, args, env }`; HTTP/SSE values are `{ type: 'http' | 'sse', url, headers? }`. Unsupported remote transports are skipped safely."
        },
        "rostrum.promptForAuth": {
          "type": "boolean",
          "default": false,
          "description": "Offer the agent's authentication methods on startup. Most agents (and all local models) need no authentication."
        },
        "rostrum.supervisorPort": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "Loopback port for the background agent supervisor. 0 picks a free port; pin one if a firewall or policy requires a known port. Takes effect the next time the supervisor starts."
        },
        "rostrum.restoreSessions": {
          "type": "string",
          "enum": [
            "all",
            "recent",
            "active"
          ],
          "default": "all",
          "description": "Which live sessions to restore after a VS Code reload: all, the five most recent, or only the previously active session."
        },
        "rostrum.maxLiveSessions": {
          "type": "integer",
          "default": 8,
          "minimum": 1,
          "description": "How many conversations stay live at once. Each live conversation holds an ACP session on a running agent. Reaching the limit asks which session to close rather than choosing for you."
        },
        "rostrum.sessionIdleMinutes": {
          "type": "integer",
          "default": 60,
          "minimum": 0,
          "description": "Close a conversation that has been idle and off-screen this long, keeping its transcript loadable. Set to 0 to never close on idle. Conversations whose agent supports neither session/load nor session/resume are never closed this way, because they could not be reopened."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "rostrum.sessionsView",
        "contents": "No sessions yet.\n[New Session](command:rostrum.newSession)\n[Install an Agent](command:rostrum.installAgent)"
      },
      {
        "view": "rostrum.outlineView",
        "contents": "The outline of the active session appears here."
      },
      {
        "view": "rostrum.changedFilesView",
        "contents": "No files changed by an agent yet."
      },
      {
        "view": "rostrum.timelineView",
        "contents": "Agent edits appear here in chronological order."
      },
      {
        "view": "rostrum.usageStatsView",
        "contents": "Token usage appears here once an agent reports it."
      }
    ],
    "keybindings": [
      {
        "command": "rostrum.nextEdit",
        "key": "alt+right",
        "when": "resourceScheme == rostrum-diff"
      },
      {
        "command": "rostrum.previousEdit",
        "key": "alt+left",
        "when": "resourceScheme == rostrum-diff"
      },
      {
        "command": "rostrum.attachSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && editorHasSelection"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "build:test": "npm run clean:test -s && esbuild src/extension/session.ts src/extension/agentProcess.ts src/extension/questions.ts src/extension/registry.ts src/extension/usage.ts src/extension/history.ts src/extension/capabilities.ts src/extension/terminals.ts src/extension/store.ts src/extension/mcp.ts src/extension/router.ts src/extension/managedSession.ts src/extension/agentConnection.ts src/extension/chatView.ts src/extension/trees.ts src/extension/export.ts src/extension/discovery.ts src/extension/changeTree.ts src/extension/timeline.ts src/extension/preferences.ts --bundle --platform=node --target=node20 --format=esm --outdir=out/test --outbase=src/extension --external:vscode --alias:vscode=./test/stubs/vscode.ts && esbuild src/manager.ts --bundle --platform=node --target=node20 --format=esm --outdir=out/test --outbase=src && esbuild src/webview/markdown.ts src/webview/highlight.ts --bundle --platform=neutral --target=es2022 --format=esm --outdir=out/test --outbase=src/webview",
    "test": "npm run build:test -s && node test/units.mjs && node test/store-safety.mjs && node test/regressions.mjs && node test/features.mjs && node test/manager.mjs && node test/chaos.mjs && node test/concurrency.mjs && node test/provider.mjs && node test/trees.mjs && node test/export.mjs && node test/discovery.mjs && node test/markdown.mjs && node test/highlight.mjs && node test/workspace.mjs && node test/preferences.mjs && node test/roundtrip.mjs",
    "test:live": "npm run build:test -s && node test/smoke-qwen.mjs",
    "test:compat": "npm run build:test -s && node test/compat-local.mjs",
    "test:extension": "npm run build -s && node test/e2e/run.mjs",
    "test:container": "node test/container.mjs",
    "clean:test": "node -e \"require('node:fs').rmSync('out/test',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.104.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "mocha": "^11.8.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "mermaid": "^11.17.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Agents execute commands in the workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Agents run as local processes and edit files on disk."
    }
  },
  "keywords": [
    "acp",
    "agent client protocol",
    "coding agent",
    "ai",
    "claude",
    "codex",
    "qwen",
    "opencode",
    "llm",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanpavlick/rostrum-acp.git"
  },
  "bugs": {
    "url": "https://github.com/ryanpavlick/rostrum-acp/issues"
  },
  "homepage": "https://github.com/ryanpavlick/rostrum-acp#readme"
}
